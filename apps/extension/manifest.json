{
  "manifest_version": 3,
  "name": "Literature Monitor B-lite",
  "version": "0.2.0",
  "description": "Local-first research paper search and weekly digest for Chrome and Edge.",
  "action": {
    "default_title": "Literature Monitor",
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/dashboard/index.html",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.openalex.org/*"
  ]
}
