{
  "manifest_version": 3,
  "name": "Literature Monitor",
  "version": "0.1.0",
  "description": "Personal literature monitoring with scheduled cloud updates.",
  "action": {
    "default_title": "Literature Monitor",
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/dashboard/index.html",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ]
}
